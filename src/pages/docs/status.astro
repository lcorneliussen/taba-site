import { existsSync } from 'node:fs';
const hasLocalEvidence = import.meta.env.DEV && existsSync(new URL('../../../public/status-evidence/report.json', import.meta.url));
const base = import.meta.env.BASE_URL;
const frontmatter = {
  title: 'Reading status',
  description: 'Read the whole situation: your Git checkout, its pull request, review and check results, shared-branch builds, and what still needs attention.',
  source: 'https://github.com/lcorneliussen/wtc-cli/blob/5b6a7c29ef8fa4ab9b5761af80b886cc15d47fc8/docs/status.md',
